---
import { clinic, addressLine } from '../data/site';
const embed = `https://www.google.com/maps?q=${encodeURIComponent(`${clinic.name}, ${addressLine}`)}&output=embed`;
---
<div class="map-facade">
  <iframe src={embed} title="Map showing Newport Homeopathy Clinic, 75 Forton Road, Newport TF10 8BU" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>
