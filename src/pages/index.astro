---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBlock from '../components/CtaBlock.astro';
import GpStatement from '../components/GpStatement.astro';
import FaqList from '../components/FaqList.astro';
import MapFacade from '../components/MapFacade.astro';
import ServiceCards from '../components/ServiceCards.astro';
import heroBg from '../assets/hero-remedies.jpg';
import kavitaPhoto from '../assets/kavita-about.jpg';
import { clinic, fees, faqs, addressLine } from '../data/site';
import { faqSchema } from '../data/schema';

// Pick five decision-relevant questions for the home page.
const pick = ['How much does a homeopathy consultation cost?', 'Can I talk to someone before I book?', 'Can I have a consultation online?', 'What happens at the first consultation?', 'How do I book?'];
const faqPreview = pick.map((q) => faqs.find((f) => f.q === q)!).filter(Boolean);

// Hero photo is the largest contentful paint: preload the AVIF set so it starts downloading with the HTML.
const HERO_WIDTHS = [640, 1024, 1440, 1672];
const heroAvif = await getImage({ src: heroBg, format: 'avif', widths: HERO_WIDTHS, quality: 70 });
const lcpImage = { srcset: heroAvif.srcSet.attribute, sizes: '100vw', type: 'image/avif' };
---
<Base
  title="Homeopath in Newport, Shropshire | Newport Homeopathy Clinic"
  description="Private homeopathy consultations with Kavita Batchu, BHMS, in Newport, Shropshire or online across the UK. Initial consultation £50. Book today."
  schema={[faqSchema(faqPreview)]}
  lcpImage={lcpImage}
>
  <!-- 1. Hero -->
  <section class="hero hero-photo">
    <Picture
      src={heroBg}
      formats={['avif', 'webp']}
      widths={HERO_WIDTHS}
      sizes="100vw"
      alt=""
      class="hero-bg"
      loading="eager"
      fetchpriority="high"
      quality={70}
    />
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Homeopathy Consultations in Newport, Shropshire</h1>
        <p class="hero-lead">Private, one-to-one consultations with {clinic.practitioner}, {clinic.qualification}, a homeopath with over {clinic.years} years' experience. In person at {clinic.street}, {clinic.locality}, or online anywhere in the UK.</p>
        <div class="cta-actions">
          <a href="/book-appointment/" class="btn btn-primary btn-lg" data-track="click_book" data-loc="hero">Book a consultation</a>
          <a href="/book-appointment/?type=discovery#enquiry" class="btn btn-outline btn-lg" data-track="click_book" data-loc="hero_discovery">Free 15-minute chat</a>
        </div>
        <p class="hero-contact">
          <a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="hero"><Icon name="phone" /> {clinic.phoneDisplay}</a>
          <a href={clinic.whatsapp} rel="noopener" data-track="click_whatsapp" data-loc="hero"><Icon name="whatsapp" /> WhatsApp</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Trust strip -->
  <section class="trust-strip" aria-label="Key facts">
    <ul class="container">
      <li><span class="trust-icon"><Icon name="award" /></span><span><strong>{clinic.years}+ years</strong> experience</span></li>
      <li><span class="trust-icon"><Icon name="pound" /></span><span><strong>£{fees.initial.price}</strong> initial consultation</span></li>
      <li><span class="trust-icon"><Icon name="video" /></span><span><strong>In person</strong> and online</span></li>
      <li><span class="trust-icon"><Icon name="clock" /></span><span><strong>{clinic.hoursShort}</strong></span></li>
    </ul>
  </section>

  <!-- 3. Meet your practitioner -->
  <section>
    <div class="container grid-2 about-grid">
      <Picture src={kavitaPhoto} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 540px" alt="Kavita Batchu, BHMS, homeopath at Newport Homeopathy Clinic" loading="lazy" class="about-banner" />
      <div>
        <h2>{clinic.practitioner}, {clinic.qualification}</h2>
        <p>Five-year BHMS degree and over {clinic.years} years' experience. Every first consultation starts with time to understand your health, lifestyle and wellbeing.</p>
        <p><a href="/about-kavita-batchu/" class="link-arrow">About Kavita</a></p>
      </div>
    </div>
  </section>

  <!-- 4. Services -->
  <section class="soft">
    <div class="container">
      <div class="section-head">
        <h2>Our services</h2>
      </div>
      <ServiceCards />
    </div>
  </section>

  <!-- 5. What to expect -->
  <section>
    <div class="container">
      <div class="section-head">
        <h2>What to expect</h2>
      </div>
      <ol class="steps">
        <li><h3>Get in touch</h3><p>Book, call or WhatsApp. A free 15-minute chat is available first.</p></li>
        <li><h3>First consultation</h3><p>A detailed one-to-one conversation, {fees.initial.duration}.</p></li>
        <li><h3>Follow-ups</h3><p>Usually {fees.followUp.interval}, in person or online.</p></li>
      </ol>
      <p><a href="/what-to-expect/" class="link-arrow">What to expect</a></p>
    </div>
  </section>

  <!-- 6. Fees -->
  <section class="soft">
    <div class="container narrow">
      <div class="section-head">
        <h2>Fees</h2>
      </div>
      <table class="fees">
        <thead><tr><th scope="col">Appointment</th><th scope="col">Length</th><th scope="col">Fee</th></tr></thead>
        <tbody>
          <tr><td>{fees.discovery.label}</td><td>{fees.discovery.duration}</td><td><strong>Free</strong></td></tr>
          <tr><td>{fees.initial.label}</td><td>{fees.initial.duration}</td><td><strong>£{fees.initial.price}</strong></td></tr>
          <tr><td>{fees.followUp.label}</td><td>{fees.followUp.duration}</td><td><strong>£{fees.followUp.price}</strong></td></tr>
        </tbody>
      </table>
      <p class="table-note">{clinic.payment}. Same fees online. <a href="/consultation-fees/">Fees and payment</a></p>
    </div>
  </section>

  <!-- 7. FAQ preview -->
  <section>
    <div class="container narrow">
      <div class="section-head">
        <h2>FAQs</h2>
      </div>
      <FaqList items={faqPreview} />
      <p class="faq-links"><a href="/frequently-asked-questions/" class="link-arrow">All FAQs</a> &nbsp; <a href="/blog/" class="link-arrow">Guides</a></p>
    </div>
  </section>

  <!-- 8. Location and hours -->
  <section class="soft">
    <div class="container grid-2">
      <div>
        <h2>Location and hours</h2>
        <address class="info-line"><Icon name="pin" /> <span>{addressLine}</span></address>
        <p class="info-line"><Icon name="clock" /> <span>{clinic.hoursText}</span></p>
        <p class="info-line"><Icon name="phone" /> <a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="page">{clinic.phoneDisplay}</a></p>
        <p><a href="/areas-we-serve/">Areas we serve</a> · <a href="/contact/">Directions</a></p>
      </div>
      <MapFacade />
    </div>
  </section>

  <!-- 9. Final CTA + GP statement -->
  <CtaBlock>
    <GpStatement />
  </CtaBlock>
</Base>
