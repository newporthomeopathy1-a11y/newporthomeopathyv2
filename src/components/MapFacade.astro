---
import { clinic, addressLine } from '../data/site';
const mapQuery = `${clinic.name}, ${addressLine}`;
const embed = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const title = 'Map showing Newport Homeopathy Clinic, 75 Forton Road, Newport TF10 8BU';
---
<div class="map-facade" data-map-src={embed} data-map-title={title}>
  <div class="map-frame">
    <div class="map-placeholder">
      <span>Select “Load map” to view the map.</span>
    </div>
  </div>
  <div class="map-details">
    <strong>{clinic.name}</strong>
    <span>{addressLine}</span>
    <p class="map-status" role="status" aria-live="polite" hidden></p>
    <div class="map-actions">
      <button type="button" class="btn btn-primary map-load">Load map</button>
      <a class="map-external-link" href={directions} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
    </div>
  </div>
</div>
