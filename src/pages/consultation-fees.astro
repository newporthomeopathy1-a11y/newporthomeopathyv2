---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import GpStatement from '../components/GpStatement.astro';
import Section from '../components/ds/Section.astro';
import Prose from '../components/ds/Prose.astro';
import { clinic, fees, formatPageUpdated } from '../data/site';
import { serviceSchema } from '../data/schema';
const discoveryChatDuration = fees.discovery.duration.replace(/^about /, '').replace(/ minutes?$/, '-minute');
const initialDurationShort = fees.initial.duration.replace(/ minutes?$/, ' min');
const pricesLastReviewed = formatPageUpdated('/consultation-fees/');
---
<Base
  title={`Homeopathy Consultation Fees | ${clinic.locality}, ${clinic.region}`}
  description={`Homeopathy prices in ${clinic.locality}, ${clinic.region}: free ${discoveryChatDuration} chat, £${fees.initial.price} initial consultation (${initialDurationShort}), £${fees.followUp.price} follow-up. Same fee online. ${clinic.payment}.`}
  breadcrumbs={[{ name: 'Consultation Fees', href: '/consultation-fees/' }]}
  schema={[serviceSchema('in-person'), serviceSchema('online')]}
>
  <PageIntro
    h1="Homeopathy Consultation Fees"
    lead={`An initial homeopathy consultation costs £${fees.initial.price} and a follow-up costs £${fees.followUp.price}, in person or online.`}
  />
  <Section>
    <div class="ds-fees-content">
      <table class="fees">
        <thead><tr><th scope="col">Appointment</th><th scope="col">Length</th><th scope="col">Fee</th></tr></thead>
        <tbody>
          <tr><td>{fees.discovery.label}</td><td>{fees.discovery.duration}</td><td>Free</td></tr>
          <tr><td>{fees.initial.label}</td><td>{fees.initial.duration}</td><td>£{fees.initial.price}</td></tr>
          <tr><td>{fees.followUp.label}</td><td>{fees.followUp.duration}</td><td>£{fees.followUp.price}</td></tr>
        </tbody>
      </table>
      <p class="table-note">Same fee in person and online</p>
      <Prose>
        <h2>What is included in the fee?</h2>
        <p>The fee covers consultation time only. An initial one-to-one appointment with {clinic.practitioner} lasts {fees.initial.duration}; a follow-up lasts {fees.followUp.duration}. The same fee applies in person and online. The free discovery chat lasts {fees.discovery.duration} and is available before booking.</p>
        <p>For more detail about the first appointment, read <a href="/what-to-expect/">what to expect at a consultation</a>. Online appointments are available <a href="/online-homeopathy-consultation/">by video across the UK</a>.</p>

        <h2>How and when do I pay?</h2>
        <p>Payment is due at or before the appointment. The accepted payment methods are {clinic.payment}. If you have a question about a fee or payment, contact the clinic by phone, WhatsApp or email using the <a href="/contact/">contact page</a>.</p>
        <p>You can request an appointment through the <a href="/book-appointment/" data-astro-reload>online booking page</a>, or contact the clinic directly. Enquiries receive a reply within one working day.</p>

        <h2>How can I change or cancel?</h2>
        <p>If you need to change or cancel an appointment, please give at least 24 hours’ notice by phone ({clinic.phoneDisplay}) or <a href={clinic.whatsapp} rel="noopener">WhatsApp</a>. Read the <a href="/booking-terms/">booking and cancellation terms</a> for the current arrangements.</p>
        <p>If you are unsure how to proceed, contact the clinic before your appointment. The <a href="/contact/">contact and directions page</a> lists the phone number, WhatsApp link and email address.</p>

        <h2>How often are follow-ups?</h2>
        <p>Follow-ups are usually {fees.followUp.interval}. Kavita may suggest an interval, and you decide whether and when to book again. A follow-up lasts {fees.followUp.duration} and costs £{fees.followUp.price}; there is no requirement to arrange another appointment.</p>

        <p>Prices last reviewed: {pricesLastReviewed}</p>
        <GpStatement />
      </Prose>
    </div>
  </Section>
  <CtaBlock text="" />
</Base>
