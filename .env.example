# Copy to .env for local development. All values are optional locally.

# --- Public (baked into the static build) ---
# GA4 measurement ID. The cookie banner and analytics only appear when this is set.
PUBLIC_GA_ID=
# Cloudflare Turnstile site key (required in production for the booking form).
PUBLIC_TURNSTILE_SITE_KEY=
# Cal.com event URLs. Set both to enable the two-step booking flow.
PUBLIC_BOOKING_INITIAL_URL=https://cal.com/newport-homeopathy/initial-consultation
PUBLIC_BOOKING_FOLLOWUP_URL=https://cal.com/newport-homeopathy/follow-up-consultation
# Legacy single-URL fallback; used for both tabs if the new URLs are not set.
PUBLIC_BOOKING_EMBED_URL=
# Legacy split URLs are also supported for existing deployments.
PUBLIC_BOOKING_EMBED_URL_INITIAL=
PUBLIC_BOOKING_EMBED_URL_FOLLOWUP=

# --- Server (booking form route /api/enquiry) ---
# Resend API key. Required in production to send enquiry emails.
RESEND_API_KEY=
# Where enquiries are sent. Defaults to cavitasuresh@yahoo.com (clinic.email in src/data/site.ts).
CLINIC_INBOX=
# Cloudflare Turnstile secret key (required in production; optional in dev).
TURNSTILE_SECRET_KEY=
# Upstash Redis REST credentials for the per-IP enquiry rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
