---
// Native <details>: works without JS, content is in the HTML for crawlers.
import type { FaqGroup } from '../data/site';

interface Props {
  items: { q: string; a: string; group: FaqGroup; link?: { href: string; label: string } }[];
  open?: boolean;
}
const { items, open = false } = Astro.props;
const groups: FaqGroup[] = [
  'Booking and fees',
  'Your consultation',
  'Online appointments',
  'About homeopathy and Kavita',
];
---
{groups.map((group) => (
  <div class="ds-faq-group" aria-labelledby={`faq-${group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
    <h2 id={`faq-${group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{group}</h2>
    <div class="faq-list">
      {items.filter((f) => f.group === group).map((f) => (
        <details open={open}>
          <summary><h3>{f.q}</h3></summary>
          <p>{f.a} {f.link && <a href={f.link.href}>{f.link.label}</a>}</p>
        </details>
      ))}
    </div>
  </div>
  ))}
