---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Section from '../components/ds/Section.astro';
import Prose from '../components/ds/Prose.astro';
---
<Base title="Cookie Policy | Newport Homeopathy Clinic" description="Which cookies this website uses and how to manage them." breadcrumbs={[{ name: 'Cookie policy', href: '/cookie-policy/' }]}>
  <PageIntro h1="Cookie Policy" lead="This policy explains how this website uses consent, analytics and third-party cookies." />
  <Section>
    <Prose>
      <h2>Strictly necessary</h2>
      <p>We store your choice in your browser’s local storage (<code>nhc_consent</code>) so we don't ask again.</p>
      <h2>Analytics (only if you accept)</h2>
      <p>Google Analytics 4 uses <code>_ga</code> and <code>_ga_*</code> cookies to count visits and button clicks. They are set only if you accept. Change your choice using "Cookie settings" in the footer.</p>
      <h2>Third-party content</h2>
      <p>Google Maps loads only when you click "View map". The booking tool and spam check may set necessary cookies.</p>
    </Prose>
  </Section>
  <CtaBlock text="" />
</Base>
