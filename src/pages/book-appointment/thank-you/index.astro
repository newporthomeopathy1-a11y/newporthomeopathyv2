---
import Base from '../../../layouts/Base.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import Section from '../../../components/ds/Section.astro';
import Prose from '../../../components/ds/Prose.astro';
import { clinic } from '../../../data/site';
---
<Base
  title="Thank You | Newport Homeopathy Clinic"
  description="We received your enquiry and will reply within one working day. Contact the clinic if urgent."
  noindex
  breadcrumbs={[{ name: 'Book a consultation', href: '/book-appointment/' }, { name: 'Thank you', href: '/book-appointment/thank-you/' }]}
>
  <Section size="md" data-lead-event data-thank-you-content>
    <Prose>
      <h1>Thank You for Your Enquiry</h1>
      <p class="lead">We've received your enquiry and will reply within one working day. If it's urgent, call {clinic.phoneDisplay}.</p>
      <p>You'll also get a confirmation email. If you don't see it, please check your spam folder.</p>
      <p><a href="/what-to-expect/">What to expect at your consultation</a></p>
    </Prose>
  </Section>
  <CtaBlock text="" />
  <Section size="md" data-booking-message hidden>
    <Prose>
      <p class="lead">Booking confirmed. Check your email.</p>
    </Prose>
  </Section>
</Base>

<script is:inline>
  (() => {
    const params = new URLSearchParams(window.location.search);
    if (window.top === window.self || params.get('source') !== 'booking') return;

    document.body.classList.add('booking-return');
    document.querySelectorAll('[data-thank-you-content]').forEach((element) => {
      element.setAttribute('hidden', '');
    });
    document.querySelector('[data-booking-message]')?.removeAttribute('hidden');

    window.parent.postMessage({
      type: 'booking_complete',
      consultation_type: params.get('type') ?? 'unknown',
      format: params.get('format') || 'unknown',
    }, window.location.origin);
  })();
</script>

<style is:global>
  body.booking-return { padding-bottom: 0 !important; }
  body.booking-return .skip-link,
  body.booking-return .topbar,
  body.booking-return .site-header,
  body.booking-return .site-footer,
  body.booking-return .cookie-banner,
  body.booking-return .mobile-actions { display: none !important; }
  body.booking-return main > :not([data-booking-message]) { display: none !important; }
</style>
