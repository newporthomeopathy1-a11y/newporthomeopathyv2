---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import MapFacade from '../components/MapFacade.astro';
import { clinic, addressLine } from '../data/site';
---
<Base
  title="Contact & Directions | Newport Homeopathy Clinic, TF10"
  description="Find Newport Homeopathy Clinic at 75 Forton Road, Newport, Shropshire TF10 8BU. Opening hours, parking, phone and WhatsApp."
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <PageIntro
    h1="Contact and Directions"
    lead={`Newport Homeopathy Clinic is at ${addressLine}. Call ${clinic.phoneDisplay}, WhatsApp or book online. Open ${clinic.hoursText}.`}
  />
  <section class="section-top-none">
    <div class="container grid-2 grid-start">
      <div class="prose">
        <h2>Get in touch</h2>
        <p>Phone: <a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="page">{clinic.phoneDisplay}</a></p>
        <p>WhatsApp: <a href={clinic.whatsapp} rel="noopener" data-track="click_whatsapp" data-loc="page">Message us on WhatsApp</a></p>
        <p>Email: <a href={`mailto:${clinic.email}`} data-track="click_email" data-loc="page">{clinic.email}</a></p>
        <h2>Opening hours</h2>
        <p>{clinic.hoursText}</p>
        <h2>Parking and access</h2>
        <!-- TODO(open item 14) -->
        <p>Please ask when you book.</p>
      </div>
      <MapFacade />
    </div>
  </section>
  <CtaBlock />
</Base>
