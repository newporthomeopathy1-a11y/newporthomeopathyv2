---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import kavitaPhoto from '../assets/kavita-about.jpg';
import Grid from '../components/ds/Grid.astro';
import Card from '../components/ds/Card.astro';
import Section from '../components/ds/Section.astro';
import Prose from '../components/ds/Prose.astro';
import { personSchema } from '../data/schema';
import { clinic, fees, formatPageUpdated, gpStatement } from '../data/site';

const lastReviewed = formatPageUpdated('/about-kavita-batchu/');
---
<Base
  title="Kavita Batchu, BHMS – Homeopath in Newport, Shropshire"
  description={`Meet ${clinic.practitioner}, BHMS-qualified homeopath with over ${clinic.years} years’ experience. Consultations in Newport and online by video across the UK.`}
  breadcrumbs={[{ name: 'About Kavita Batchu', href: '/about-kavita-batchu/' }]}
  schema={[personSchema()]}
>
  <PageIntro
    h1="About Kavita Batchu, BHMS – Homeopath"
    lead="Kavita Batchu offers private consultations in Newport and online across the UK."
  />
  <Section>
    <Grid cols={2} class="ds-about-profile-layout">
      <div class="ds-about-profile">
        <Picture src={kavitaPhoto} formats={['avif', 'webp']} widths={[480, 800, 1200, 1448]} sizes="(max-width: 991px) 420px, 360px" alt="Kavita Batchu, homeopath at Newport Homeopathy Clinic, Shropshire" loading="lazy" decoding="async" class="ds-about-photo" />
        <Card title="At a glance" titleAs="h2" class="ds-about-glance">
          <dl class="ds-about-facts">
            <div><dt>Qualification</dt><dd>{clinic.qualification}</dd></div>
            <div><dt>Experience</dt><dd>Over {clinic.years} years</dd></div>
            <div><dt>Consultations</dt><dd>In person in {clinic.locality} and online across the UK</dd></div>
            <div><dt>Hours</dt><dd>{clinic.hoursText}</dd></div>
          </dl>
        </Card>
      </div>
      <Prose>
        <p>Kavita Batchu is a homeopath with a {clinic.qualificationFull} degree and over {clinic.years} years’ experience. She offers private, one-to-one consultations in Newport and by video across the UK.</p>

        <h2>Qualification</h2>
        <p>Kavita holds a BHMS qualification. The full degree name is {clinic.qualificationFull}. Her work as a homeopath brings this qualification and more than {clinic.years} years’ experience into one-to-one appointments with clients.</p>
        <p>Consultations are available in person at {clinic.street}, Newport, Shropshire, or online from anywhere in the UK. The format is your choice when you enquire or book.</p>

        <h2>How Kavita works</h2>
        <p>A first consultation is a private conversation about your health history, lifestyle and wellbeing. It lasts {fees.initial.duration}, giving time to talk through the subjects you wish to raise. Follow-up appointments usually take place {fees.followUp.interval} and last {fees.followUp.duration}.</p>
        <p>Appointments are one-to-one. Kavita asks about health history and day-to-day lifestyle, and you can ask questions about the appointment. You decide whether to book a follow-up; there is no obligation to arrange another appointment.</p>

        <h2>Appointments and fees</h2>
        <p>An initial consultation costs £{fees.initial.price}; a follow-up costs £{fees.followUp.price}. The same fee applies in person and online. Payment is due at or before the appointment by {clinic.payment.toLowerCase()}.</p>
        <p>For more detail, see the <a href="/consultation-fees/">consultation fees</a>, <a href="/homeopathy-consultations/">in-person appointments in Newport</a> and <a href="/online-homeopathy-consultation/">online consultations by video</a>. A free chat lasting {fees.discovery.duration} is available before booking.</p>

        <h2>Working alongside your GP</h2>
        <p>{gpStatement}</p>
        <p>Last reviewed: {lastReviewed}</p>
        <p>For appointment details, visit the <a href="/book-appointment/">booking page</a> or <a href="/contact/">contact Newport Homeopathy Clinic</a>.</p>
      </Prose>
    </Grid>
  </Section>
  <CtaBlock text="" />
</Base>
