---
import '../styles/global.css';
import '../styles/design-system.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, clinic, nav, addressLine, gpStatementShort, aiLinks, aiPrompt } from '../data/site';
import { siteGraph, breadcrumbSchema } from '../data/schema';
import BackLink from '../components/BackLink.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { name: string; href: string }[];
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  preconnects?: string[];
  footerPractitionerLabel?: string;
  /** Blog posts: ISO dates for article:published_time / modified_time. */
  published?: Date;
  updated?: Date;
  /** Largest-contentful-paint image to preload (responsive srcset). */
  lcpImage?: { srcset: string; sizes: string; type: string };
}
const { title, description, breadcrumbs, schema = [], noindex = false, ogType = 'website', preconnects = [], footerPractitionerLabel = clinic.title, published, updated, lcpImage } = Astro.props;
const ogImage = `${SITE}/og-image.jpg`;
const ogImageAlt = `${clinic.title} at ${clinic.name}`;
const path = Astro.url.pathname;
const canonical = `${SITE}${path}`;
const allSchema = [siteGraph(), ...(breadcrumbs?.length ? [breadcrumbSchema(breadcrumbs)] : []), ...schema];
const showBackLink = Boolean(breadcrumbs?.length) && path !== '/' && path !== '/404/';
const backHref = path.startsWith('/blog/') && path !== '/blog/' ? '/blog/' : '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
const gaId = import.meta.env.PUBLIC_GA_ID ?? '';
const topbarEmail = clinic.email;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <ClientRouter fallback="none" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/fonts/open-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preconnects.map((origin) => <link rel="preconnect" href={origin} crossorigin />)}
    {lcpImage && <link rel="preload" as="image" imagesrcset={lcpImage.srcset} imagesizes={lcpImage.sizes} type={lcpImage.type} fetchpriority="high" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {(updated ?? published) && <meta property="article:modified_time" content={(updated ?? published)!.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="format-detection" content="telephone=yes" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {allSchema.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline define:vars={{ gaId }}>
      // Consent Mode v2: everything denied until the visitor accepts (spec Part 9).
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      window.__GA_ID = gaId;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="topbar">
      <div class="container ds-container ds-wide-container topbar-inner">
        <a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="header"><Icon name="phone" /> {clinic.phoneDisplay}</a>
        <a href={clinic.whatsapp} rel="noopener" data-track="click_whatsapp" data-loc="header"><Icon name="whatsapp" /> WhatsApp</a>
        <a href={`mailto:${topbarEmail}`} data-track="click_email" data-loc="header"><Icon name="mail" /> {topbarEmail}</a>
        <span class="topbar-hours">{clinic.hoursShort}</span>
      </div>
    </div>

    <header class="site-header">
      <div class="container ds-container ds-wide-container header-inner">
        <a href="/" class="logo" data-astro-prefetch="viewport">
          <picture>
            <source type="image/avif" srcset="/assets/img/clinic-logo-224.avif 224w, /assets/img/clinic-logo-448.avif 448w, /assets/img/clinic-logo-672.avif 672w" sizes="(max-width: 991px) 200px, 224px" />
            <img src="/assets/img/clinic-logo-448.webp" srcset="/assets/img/clinic-logo-224.webp 224w, /assets/img/clinic-logo-448.webp 448w, /assets/img/clinic-logo-672.webp 672w" sizes="(max-width: 991px) 200px, 224px" alt="Newport Homeopathy Clinic" width="448" height="100" loading="eager" decoding="async" fetchpriority="high">
          </picture>
        </a>
        <button type="button" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
          <Icon name="menu" class="icon-open" /><Icon name="close" class="icon-close" />
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <div class="mobile-menu-top">
            <a href="/" class="mobile-menu-logo" data-astro-prefetch="viewport">
              <picture>
                <source type="image/avif" srcset="/assets/img/clinic-logo-224.avif 224w, /assets/img/clinic-logo-448.avif 448w, /assets/img/clinic-logo-672.avif 672w" sizes="150px" />
                <img src="/assets/img/clinic-logo-448.webp" srcset="/assets/img/clinic-logo-224.webp 224w, /assets/img/clinic-logo-448.webp 448w, /assets/img/clinic-logo-672.webp 672w" sizes="150px" alt="Newport Homeopathy Clinic" width="448" height="100" loading="lazy" decoding="async">
              </picture>
            </a>
            <button type="button" class="nav-close" aria-label="Close menu" aria-controls="site-nav">
              <Icon name="close" />
            </button>
          </div>
          <ul>
            {nav.map((item, index) =>
              item.children ? (
                <li class="has-sub" style={`--menu-index: ${index};`}>
                  <a class="consultations-fallback" href={item.children[0].href} data-astro-prefetch="viewport">
                    {item.label}<Icon name="chevron" class="menu-chevron" />
                  </a>
                  <button
                    type="button"
                    class="consultations-toggle"
                    aria-expanded="false"
                    aria-controls={`consultations-panel-${index}`}
                  >
                    {item.label}<Icon name="chevron" class="menu-chevron" />
                  </button>
                  <div class="consultations-panel" id={`consultations-panel-${index}`}>
                    {item.children.slice(0, 2).map((c, childIndex) => (
                      <a class="consultation-option" href={c.href} data-astro-prefetch="viewport" aria-current={isActive(c.href) ? 'page' : undefined}>
                        <span class="consultation-option-title">{childIndex === 0 ? 'In person' : 'Online'}</span>
                      </a>
                    ))}
                  </div>
                </li>
              ) : (
                <li style={`--menu-index: ${index};`}><a href={item.href} data-astro-prefetch="viewport" aria-current={isActive(item.href!) ? 'page' : undefined}>{item.label}</a></li>
              )
            )}
          </ul>
          <div class="mobile-menu-actions">
            <a href="/book-appointment/" class="btn btn-primary" data-astro-prefetch="tap" data-astro-reload data-track="click_book" data-loc="header">Book a consultation</a>
            <div class="mobile-menu-contacts">
              <a href={`tel:${clinic.phoneTel}`} class="btn btn-outline" data-track="click_call" data-loc="header"><Icon name="phone" /> Call</a>
              <a href={clinic.whatsapp} class="btn btn-outline" rel="noopener" data-track="click_whatsapp" data-loc="header"><Icon name="whatsapp" /> WhatsApp</a>
            </div>
            <p class="mobile-menu-gp ds-mobile-menu-gp">{gpStatementShort}</p>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      {showBackLink && <div class="container ds-container"><BackLink href={backHref} /></div>}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container ds-container footer-grid">
        <div class="footer-about">
          <a href="/" class="footer-logo" data-astro-prefetch="viewport">
            <picture>
              <source type="image/avif" srcset="/assets/img/clinic-logo-224.avif 224w, /assets/img/clinic-logo-448.avif 448w, /assets/img/clinic-logo-672.avif 672w" sizes="196px" />
              <img src="/assets/img/clinic-logo-448.webp" srcset="/assets/img/clinic-logo-224.webp 224w, /assets/img/clinic-logo-448.webp 448w, /assets/img/clinic-logo-672.webp 672w" sizes="196px" alt="Newport Homeopathy Clinic" width="448" height="100" loading="lazy" decoding="async">
            </picture>
          </a>
          <ul class="footer-contact-list">
            <li class="footer-line"><Icon name="user" /> <a href="/about-kavita-batchu/" data-astro-prefetch="viewport">{footerPractitionerLabel}</a></li>
            <li class="footer-line"><Icon name="pin" /> <a href={clinic.mapsUrl} rel="noopener" data-track="click_directions" data-loc="footer">{addressLine}</a></li>
            <li class="footer-line"><Icon name="phone" /> <a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="footer">{clinic.phoneIntl}</a></li>
            <li class="footer-line"><Icon name="whatsapp" /> <a href={clinic.whatsapp} rel="noopener" data-track="click_whatsapp" data-loc="footer">WhatsApp</a></li>
            <li class="footer-line"><Icon name="mail" /> <a href={`mailto:${clinic.email}`} data-track="click_email" data-loc="footer">{clinic.email}</a></li>
            <li class="footer-line"><Icon name="clock" /> <span>{clinic.hoursText}</span></li>
          </ul>
          <div class="ask-ai" data-prompt={aiPrompt}>
            <p class="ask-ai-label">Ask about Newport Homeopathy Clinic on:</p>
            <ul class="ask-ai-list">
              {aiLinks.map((l) => (
                <li>
                  <a
                    class="ask-ai-btn"
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Ask ${l.label} about Newport Homeopathy Clinic`}
                    title={`Ask ${l.label}`}
                    data-track={`click_ai_${l.id}`}
                    data-loc="footer"
                    data-copy-prompt={l.copy ? 'true' : undefined}
                  >
                    <span class="ask-ai-icon" style={`--icon: url(/ai-icons/${l.id}.svg)`} aria-hidden="true"></span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="ask-ai-status" role="status" aria-live="polite"></p>
          </div>
          <p class="footer-disclaimer">{gpStatementShort}</p>
        </div>
        <div>
          <p class="footer-heading">Services</p>
          <ul>
            <li><a href="/homeopathy-consultations/" data-astro-prefetch="viewport">In person in Newport</a></li>
            <li><a href="/online-homeopathy-consultation/" data-astro-prefetch="viewport">Online across the UK</a></li>
            <li><a href="/consultation-fees/" data-astro-prefetch="viewport">Fees</a></li>
            <li><a href="/what-to-expect/" data-astro-prefetch="viewport">What to expect</a></li>
            <li><a href="/areas-we-serve/" data-astro-prefetch="viewport">Areas we serve</a></li>
            <li><a href="/book-appointment/" data-astro-prefetch="tap" data-astro-reload>Book a consultation</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-heading">Clinic</p>
          <ul>
            <li><a href="/about-kavita-batchu/" data-astro-prefetch="viewport">About Kavita Batchu</a></li>
            <li><a href="/frequently-asked-questions/" data-astro-prefetch="viewport">FAQs</a></li>
            <li><a href="/blog/" data-astro-prefetch="viewport">Guides and articles</a></li>
            <li><a href="/contact/" data-astro-prefetch="viewport">Contact and directions</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-heading">Policies</p>
          <ul>
            <li><a href="/privacy-policy/" data-astro-prefetch="viewport">Privacy policy</a></li>
            <li><a href="/cookie-policy/" data-astro-prefetch="viewport">Cookie policy</a></li>
            <li><a href="/booking-terms/" data-astro-prefetch="viewport">Booking terms</a></li>
            <li><button type="button" class="link-button" data-cookie-settings>Cookie settings</button></li>
          </ul>
          {clinic.social.facebook && <a href={clinic.social.facebook} rel="noopener" aria-label="Facebook">Facebook</a>}
          {clinic.social.instagram && <a href={clinic.social.instagram} rel="noopener" aria-label="Instagram">Instagram</a>}
        </div>
      </div>
      <div class="container ds-container footer-base">
        <p>© {year} {clinic.name} · Designed &amp; Developed by Articog Tech LLP</p>
      </div>
    </footer>

    <nav class="mobile-actions" aria-label="Quick contact">
      <a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="sticky_bar"><Icon name="phone" /> Call</a>
      <a href={clinic.whatsapp} rel="noopener" data-track="click_whatsapp" data-loc="sticky_bar"><Icon name="whatsapp" /> WhatsApp</a>
      <a href="/book-appointment/" data-astro-prefetch="tap" data-astro-reload data-track="click_book" data-loc="sticky_bar"><Icon name="calendar" /> Book</a>
    </nav>

    <div class="cookie-banner" role="region" aria-label="Cookie consent" hidden>
      <p>We'd like to use analytics cookies to understand how visitors use this site. They are off unless you accept. <a href="/cookie-policy/">Cookie policy</a></p>
      <div class="cookie-actions">
        <button type="button" class="btn btn-outline" data-consent="reject">Reject</button>
        <button type="button" class="btn btn-outline" data-consent="accept">Accept</button>
      </div>
    </div>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
