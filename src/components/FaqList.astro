---
// Native <details>: works without JS, content is in the HTML for crawlers.
import type { FaqGroup } from '../data/site';

interface Props {
  items: { q: string; a: string; group: FaqGroup; link?: { href: string; label: string } }[];
  open?: boolean;
  grouped?: boolean;
}
const { items, open = false, grouped = true } = Astro.props;
const groups: FaqGroup[] = [
  'Booking and fees',
  'Your consultation',
  'Online appointments',
  'About homeopathy and Kavita',
];
const visibleGroups: (FaqGroup | null)[] = grouped ? groups : [null];
---
{visibleGroups.map((group) => {
  const headingId = group ? `faq-${group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
  const groupItems = group ? items.filter((item) => item.group === group) : items;
  return (
  <div class:list={['ds-faq-group', !group && 'ds-faq-flat']} aria-labelledby={headingId}>
    {group && <h2 id={headingId}>{group}</h2>}
    <div class="faq-list">
      {groupItems.map((f) => (
        <details open={open}>
          <summary><h3>{f.q}</h3></summary>
          <p>{f.a}{f.link && ' '}{f.link && <a href={f.link.href}>{f.link.label}</a>}</p>
        </details>
      ))}
    </div>
  </div>
  );
})}
