---
interface Props {
  title: string;
  lead?: string;
  as?: 'h2' | 'h3' | 'h4';
  align?: 'left' | 'center';
  eyebrow?: string;
}

const { title, lead, as: Heading = 'h2', align = 'center', eyebrow } = Astro.props;
---
<header class:list={['ds-section-header', align === 'left' && 'ds-section-header-left']}>
  {eyebrow && <p class="ds-eyebrow">{eyebrow}</p>}
  <Heading class="ds-section-heading">{title}</Heading>
  {lead && <p class="ds-section-lead">{lead}</p>}
</header>
