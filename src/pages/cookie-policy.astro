---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Section from '../components/ds/Section.astro';
import Prose from '../components/ds/Prose.astro';
---
<Base title="Cookie Policy | Newport Homeopathy Clinic" description="This site does not use analytics or tracking cookies." breadcrumbs={[{ name: 'Cookie policy', href: '/cookie-policy/' }]}>
  <PageIntro h1="Cookie Policy" lead="This site does not use analytics or tracking cookies." />
  <Section>
    <Prose>
      <h2>Third-party content</h2>
      <p>Google Maps loads when the map section scrolls into view and Google may set cookies or receive your IP address. The booking tool and spam check may set necessary cookies.</p>
    </Prose>
  </Section>
  <CtaBlock text="" />
</Base>
