---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Section from '../../components/ds/Section.astro';
import Grid from '../../components/ds/Grid.astro';
import Card from '../../components/ds/Card.astro';
import { collectionPageSchema } from '../../data/schema';
import { clinic } from '../../data/site';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.published - +a.data.published);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Homeopathy Guides & Articles | Newport Homeopathy Clinic"
  description={`Plain-English guides to homeopathy consultations, fees, online appointments, qualifications and choosing a homeopath in the UK, by ${clinic.practitioner}, ${clinic.qualification}.`}
  breadcrumbs={[{ name: 'Guides and articles', href: '/blog/' }]}
  schema={[collectionPageSchema()]}
>
  <PageIntro h1="Guides and Articles" lead="Practical guides on booking, fees, online appointments and what happens at a homeopathy consultation, reviewed by Kavita Batchu, BHMS." />
  <Section>
    <Grid cols={3} class={posts.length === 1 ? 'ds-blog-single' : 'ds-blog-grid'}>
      {posts.map((p) => (
        <Card title={p.data.title} titleAs="h2" href={`/blog/${p.id}/`} class="ds-blog-card">
          <p class="post-meta"><time datetime={p.data.published.toISOString().slice(0, 10)}>{fmt(p.data.published)}</time></p>
          <p>{p.data.description}</p>
        </Card>
      ))}
    </Grid>
  </Section>
  <CtaBlock />
</Base>
