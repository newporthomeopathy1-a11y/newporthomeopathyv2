---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import kavitaPhoto from '../assets/kavita-about.jpg';
import { clinic } from '../data/site';
import { personSchema } from '../data/schema';
---
<Base
  title="Kavita Batchu, BHMS – Homeopath in Newport, Shropshire"
  description="Meet Kavita Batchu, BHMS, a homeopath with over 15 years' experience offering private consultations in Newport, Shropshire and online."
  breadcrumbs={[{ name: 'About Kavita Batchu', href: '/about-kavita-batchu/' }]}
  schema={[personSchema()]}
>
  <PageIntro
    h1="About Kavita Batchu, BHMS"
    lead={`A homeopath with over ${clinic.years} years' experience, seeing clients in Newport, Shropshire and online across the UK.`}
  />
  <section class="section-top-none">
    <div class="container grid-2 about-grid grid-start">
      <Picture src={kavitaPhoto} formats={['avif', 'webp']} widths={[480, 800, 1200, 1448]} sizes="(max-width: 860px) 100vw, 560px" alt="Kavita Batchu, BHMS, homeopath at Newport Homeopathy Clinic" loading="eager" class="about-banner" />
      <div class="prose">
        <h2>Training</h2>
        <p>I hold a five-year Bachelor of Homeopathic Medicine and Surgery (BHMS) degree from India.</p>
        <!-- TODO(open item 1): add confirmed professional body membership + register link. Do not publish the old "Royal Society of Homeopaths" wording. -->
        <h2>How I work</h2>
        <p>Your first consultation is a detailed conversation about your health history, lifestyle and wellbeing.</p>
        <p><a href="/homeopathy-consultations/">In person</a> · <a href="/online-homeopathy-consultation/">Online</a> · <a href="/consultation-fees/">Fees</a></p>
      </div>
    </div>
  </section>
  <CtaBlock />
</Base>
