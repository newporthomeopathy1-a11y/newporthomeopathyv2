---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import GpStatement from '../components/GpStatement.astro';
import Section from '../components/ds/Section.astro';
import SectionHeader from '../components/ds/SectionHeader.astro';
import Grid from '../components/ds/Grid.astro';
import Card from '../components/ds/Card.astro';
import Prose from '../components/ds/Prose.astro';
import { areas, addressLine, clinic, formatPageUpdated } from '../data/site';

const lastReviewed = formatPageUpdated('/areas-we-serve/');
const areaCopy: Record<string, string> = {
  Newport: `${clinic.name} is in Newport itself. The same consultation is also available online at the same fee.`,
  Telford: 'From Telford, people can come to the Newport clinic or choose the same consultation online at the same fee.',
  Edgmond: 'People in Edgmond may attend the Newport clinic. Online, the same consultation is available at the same fee.',
  Gnosall: 'The Newport clinic is an in-person option for people from Gnosall, with the same consultation available online at the same fee.',
  'Market Drayton': 'For people in Market Drayton, there is a choice: visit the Newport clinic or have the same consultation online at the same fee.',
  Stafford: 'People from Stafford are welcome at the Newport clinic, and can also choose the same consultation online for the same fee.',
  Shrewsbury: 'If you are in Shrewsbury, you may book at the Newport clinic. The same consultation is also offered online at the same fee.',
};
---
<Base
  title="Homeopath near Telford, Stafford & Shrewsbury | Newport"
  description={`In-person consultations at ${addressLine}, with online appointments available across the UK.`}
  breadcrumbs={[{ name: 'Areas we serve', href: '/areas-we-serve/' }]}
>
  <PageIntro
    h1="A Homeopath for Telford, Stafford, Shrewsbury and Nearby"
    lead={`The clinic is at ${addressLine}, with parking and step-free access available for in-person appointments. The same consultation can also be booked online at the same fee.`}
  />
  <Section>
    <SectionHeader eyebrow="In-person appointments" title="Towns we serve" />
    <Grid cols={4} as="ul" class="ds-town-cards">
      {areas.map((area) => {
        const copy = areaCopy[area];
        if (!copy) throw new Error(`Missing area copy for "${area}".`);
        return (
          <Card as="li" title={area}>
            <p>{copy}</p>
            <a slot="link" href="/book-appointment/" class="btn btn-outline ds-card-link">Book from {area}</a>
          </Card>
        );
      })}
    </Grid>
  </Section>
  <Section>
    <Prose>
      <h2>Online consultations are available anywhere in the UK</h2>
      <p>Find out about <a href="/online-homeopathy-consultation/">online homeopathy consultations by video</a>, or read the <a href="/consultation-fees/">consultation fees</a>.</p>
      <p>For more information about the clinic, read the <a href="/contact/">contact and directions page</a>. Last reviewed: {lastReviewed}</p>
      <GpStatement />
    </Prose>
  </Section>
  <CtaBlock text="" />
</Base>
