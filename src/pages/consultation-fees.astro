---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { clinic, fees, formatPageUpdated } from '../data/site';
import { serviceSchema } from '../data/schema';
const discoveryChatDuration = fees.discovery.duration.replace(/^about /, '').replace(/ minutes?$/, '-minute');
const initialDurationShort = fees.initial.duration.replace(/ minutes?$/, ' min');
const pricesLastReviewed = formatPageUpdated('/consultation-fees/');
---
<Base
  title={`Homeopathy Consultation Fees | ${clinic.locality}, ${clinic.region}`}
  description={`Homeopathy prices in ${clinic.locality}, ${clinic.region}: free ${discoveryChatDuration} chat, £${fees.initial.price} initial consultation (${initialDurationShort}), £${fees.followUp.price} follow-up. Same fee online. ${clinic.payment}.`}
  breadcrumbs={[{ name: 'Consultation Fees', href: '/consultation-fees/' }]}
  schema={[serviceSchema('in-person'), serviceSchema('online')]}
>
  <PageIntro
    h1="Homeopathy Consultation Fees"
    lead={`An initial homeopathy consultation costs £${fees.initial.price} and a follow-up costs £${fees.followUp.price}, in person or online.`}
  />
  <section class="section-top-none">
    <div class="container text-col">
      <table class="fees">
        <thead><tr><th scope="col">Appointment</th><th scope="col">Length</th><th scope="col">Fee</th></tr></thead>
        <tbody>
          <tr><td>{fees.discovery.label}</td><td>{fees.discovery.duration}</td><td>Free</td></tr>
          <tr><td>{fees.initial.label}</td><td>{fees.initial.duration}</td><td>£{fees.initial.price}</td></tr>
          <tr><td>{fees.followUp.label}</td><td>{fees.followUp.duration}</td><td>£{fees.followUp.price}</td></tr>
        </tbody>
      </table>
      <p class="table-note">Same fee in person and online</p>
      <div class="prose fees-details">
        <h2>What’s included in the fee</h2>
        <p>The consultation is one-to-one with {clinic.practitioner}. An initial consultation lasts {fees.initial.duration}; a follow-up lasts {fees.followUp.duration}.</p>
        {/* CLINIC INPUT: Are remedies included? */}

        <h2>How and when to pay</h2>
        <p>Payment is due at or before the appointment. Payment methods: {clinic.payment}.</p>

        <h2>Changing or cancelling</h2>
        <p>Please give at least 24 hours’ notice to change or cancel by phone ({clinic.phoneDisplay}) or <a href={clinic.whatsapp} rel="noopener">WhatsApp</a>. See the <a href="/booking-terms/">booking terms</a>.</p>

        <h2>How often are follow-ups?</h2>
        <p>Kavita suggests an interval, usually {fees.followUp.interval}, and you decide whether to book.</p>

        <p>Prices last reviewed: {pricesLastReviewed}</p>
      </div>
    </div>
  </section>
  <CtaBlock text="" />
</Base>
