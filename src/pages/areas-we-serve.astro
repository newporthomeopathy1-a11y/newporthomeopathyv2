---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Section from '../components/ds/Section.astro';
import Prose from '../components/ds/Prose.astro';
import Grid from '../components/ds/Grid.astro';
import Card from '../components/ds/Card.astro';
import { areas, clinic } from '../data/site';
---
<Base
  title="Homeopath near Telford, Stafford & Shrewsbury | Newport"
  description={`Homeopathy consultations in ${clinic.locality}, ${clinic.region}, ${areas.slice(1).join(', ')}. Or book online.`}
  breadcrumbs={[{ name: 'Areas we serve', href: '/areas-we-serve/' }]}
>
  <PageIntro
    h1="A Homeopath for Telford, Stafford, Shrewsbury and Nearby"
    lead="The Newport clinic serves nearby areas across east Shropshire and west Staffordshire."
  />
  <Section>
    <Prose>
      <h2>Nearby areas</h2>
    </Prose>
    {/* CLINIC INPUT: Confirm drive times before adding any travel estimates to the areas page. */}
    <Grid cols={4} class="ds-town-cards">
      {areas.map((area) => <Card title={area} />)}
    </Grid>
    <Prose>
      <p>Online consultations are available anywhere in the UK.</p>
      <p><a href="/online-homeopathy-consultation/">Online consultations</a> · <a href="/contact/">Directions</a> · <a href="/consultation-fees/">Fees</a></p>
    </Prose>
  </Section>
  <CtaBlock text="" />
</Base>
