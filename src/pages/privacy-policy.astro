---
import Base from '../layouts/Base.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { clinic, addressLine } from '../data/site';
---
<Base title="Privacy Policy | Newport Homeopathy Clinic" description="How Newport Homeopathy Clinic collects, uses and protects your personal information." breadcrumbs={[{ name: 'Privacy policy', href: '/privacy-policy/' }]}>
  <section>
    <div class="container prose">
      <h1>Privacy Policy</h1>
      <p class="lead">This policy explains how Newport Homeopathy Clinic handles personal information.</p>
      {/* TODO: Confirm controller details and the ICO fee before launch. */}
      <h2>Who we are</h2>
      <p>{clinic.name}, {addressLine} is the data controller for personal information collected through this website. Contact: <a href={`mailto:${clinic.email}`}>{clinic.email}</a>.</p>
      <h2>What we collect</h2>
      <p>An enquiry collects your name, email, phone, consultation type and format, preferred date and time, and any message you send. Please don't include medical details.</p>
      <h2>Why we use it and our lawful basis</h2>
      <p>We use these details to reply and arrange your appointment. Our lawful basis is your consent and, after booking, steps taken at your request before a contract.</p>
      <h2>Who we share it with</h2>
      <p>Our email provider and Cal.com, used to schedule consultations, process data for us under contract. We never sell your data or use advertising pixels.</p>
      <h2>Analytics</h2>
      <p>With consent, Google Analytics counts visits and button clicks. It never receives your name, email, phone or message. See our <a href="/cookie-policy/">cookie policy</a>.</p>
      <h2>How long we keep it</h2>
      <p>We delete enquiries after 12 months unless you become a client. Client records follow professional guidance.</p>
      <h2>Your rights</h2>
      <p>Email us to access, correct or delete your information, or withdraw consent. You can complain to the Information Commissioner's Office at <a href="https://ico.org.uk/make-a-complaint/" rel="noopener">ico.org.uk</a>.</p>
    </div>
  </section>
  <CtaBlock text="" />
</Base>
