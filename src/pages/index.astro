---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GpStatement from '../components/GpStatement.astro';
import FaqList from '../components/FaqList.astro';
import MapFacade from '../components/MapFacade.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Reviews from '../components/Reviews.astro';
import Container from '../components/ds/Container.astro';
import Section from '../components/ds/Section.astro';
import SectionHeader from '../components/ds/SectionHeader.astro';
import Grid from '../components/ds/Grid.astro';
import Card from '../components/ds/Card.astro';
import heroBg from '../assets/hero-remedies.jpg';
import kavitaPhoto from '../assets/kavita-about.jpg';
import { clinic, fees, addressLine, areas, services, reviews, faqs } from '../data/site';

// Hero photo is the largest contentful paint: preload the AVIF set so it starts downloading with the HTML.
const HERO_WIDTHS = [640, 1024, 1440, 1672];
const heroAvif = await getImage({ src: heroBg, format: 'avif', widths: HERO_WIDTHS, quality: 90 });
const lcpImage = { srcset: heroAvif.srcSet.attribute, sizes: '100vw', type: 'image/avif' };
const discoveryChatDuration = fees.discovery.duration.replace(/^about /, '').replace(/ minutes?$/, '-min');
const discoveryChatButtonLabel = `Free ${fees.discovery.duration.replace(/^about /, '').replace(/ minutes?$/, '-minute')} chat`;
const homeFaqQuestions = [
  'How do I book?',
  'What happens at the first consultation?',
  'Can I have a consultation online?',
  'What is homeopathy?',
];
const homeFaqs = homeFaqQuestions.map((question) => {
  const faq = faqs.find((item) => item.q === question);
  if (!faq) throw new Error(`Missing home page FAQ "${question}" in src/data/site.ts.`);
  return faq;
});
const featuredAreaNames = ['Newport', 'Telford', 'Stafford', 'Shrewsbury', 'Market Drayton'];
const featuredAreas = featuredAreaNames.map((name) => {
  const area = areas.find((candidate) => candidate === name);
  if (!area) throw new Error(`Missing featured area "${name}" in src/data/site.ts.`);
  return area;
});
---
<Base
  title="Homeopath in Newport, Shropshire | Newport Homeopathy Clinic"
  description={`Homeopathy consultations with ${clinic.practitioner}, ${clinic.qualification}, at ${clinic.street}, ${clinic.locality} ${clinic.postcode.split(' ')[0]}, or online UK-wide. £${fees.initial.price} initial, £${fees.followUp.price} follow-up. Free ${discoveryChatDuration} chat.`}
  lcpImage={lcpImage}
  footerPractitionerLabel={clinic.practitioner}
>
  <section class="ds-hero">
    <div class="ds-hero-media">
      <Picture
        src={heroBg}
        formats={['avif', 'webp']}
        widths={HERO_WIDTHS}
        sizes="100vw"
        alt=""
        class="ds-hero-image"
        loading="eager"
        fetchpriority="high"
        quality={90}
      />
      <span class="ds-hero-chip">{clinic.practitioner}, {clinic.qualification} · {clinic.years}+ years’ experience</span>
    </div>
    <Container class="ds-wide-container">
      <div class="ds-hero-content">
        <p class="ds-eyebrow">Homeopath in Newport, Shropshire</p>
        <h1 class="ds-hero-title">Homeopathy Consultations in Newport, Shropshire</h1>
        <p class="ds-hero-lead">One-to-one consultations with {clinic.practitioner}, {clinic.qualification}, in Newport or online across the UK.</p>
        <div class="ds-hero-actions">
          <a href="/book-appointment/" class="btn btn-primary btn-lg" data-astro-prefetch="tap" data-track="click_book" data-loc="hero">Book a consultation</a>
          <a href={clinic.whatsapp} class="btn btn-outline btn-lg" rel="noopener" data-track="click_whatsapp" data-loc="hero">{discoveryChatButtonLabel}</a>
        </div>
        <div class="ds-hero-contact" role="group" aria-label="Contact the clinic">
          <a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="hero"><Icon name="phone" /> Call {clinic.phoneDisplay}</a>
          <a href={clinic.whatsapp} rel="noopener" data-track="click_whatsapp" data-loc="hero"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
      </div>
    </Container>
  </section>

  <section class="ds-trust-strip" aria-label="Clinic information">
    <Container class="ds-wide-container">
      <ul class="ds-trust-grid">
      <li><span class="trust-icon"><Icon name="award" /></span><span><strong>{clinic.title}</strong></span></li>
      <li><span class="trust-icon"><Icon name="pound" /></span><span><strong>£{fees.initial.price}</strong> initial consultation</span></li>
      <li><span class="trust-icon"><Icon name="video" /></span><span><strong>In person</strong> and online</span></li>
      <li><span class="trust-icon"><Icon name="clock" /></span><span><strong>{clinic.hoursShort}</strong></span></li>
      </ul>
    </Container>
  </section>

  <Section tone="soft" class="ds-home-about">
    <Grid cols={2} class="ds-grid-861 ds-about-layout">
      <div class="ds-about-copy">
        <SectionHeader align="left" eyebrow="Newport Homeopathy Clinic" title="About the clinic" />
        <p>At {addressLine}, {clinic.practitioner} offers one-to-one consultations in person or by video from anywhere in the UK. Find out <a href="/what-to-expect/">what to expect</a>.</p>
        <p>Homeopathy is a system of complementary medicine developed by Samuel Hahnemann in the late 1700s. Please keep seeing your GP, and read more in our <a href="/frequently-asked-questions/">frequently asked questions</a>.</p>
      </div>
      <div class="ds-about-stats" aria-label="Clinic details">
        <Card class="ds-stat-card">
          <strong class="ds-stat-value">{fees.initial.duration}</strong>
          <span>First consultation</span>
        </Card>
        <Card class="ds-stat-card">
          <strong class="ds-stat-value">In person + online</strong>
          <span>Consultation options</span>
        </Card>
        <Card class="ds-stat-card">
          <strong class="ds-stat-value">{clinic.hoursShort}</strong>
          <span>Clinic hours</span>
        </Card>
      </div>
    </Grid>
    <section class="ds-home-why" aria-label="Why people choose the clinic">
      <SectionHeader eyebrow="A considered approach" title="Why people choose the clinic" />
      <Grid cols={4} class="ds-choice-grid">
        <Card title="Time to talk" icon="clock">
          <p>A first consultation lasts {fees.initial.duration}.</p>
        </Card>
        <Card title="Same fee online" icon="video">
          <p>The same consultation fee applies online and in person.</p>
        </Card>
        <Card title="Saturday appointments" icon="clock">
          <p>Appointments are available on Saturdays ({clinic.hoursShort}).</p>
        </Card>
        <Card title="Chat before booking" icon="whatsapp">
          <p>A discovery chat is available before booking.</p>
        </Card>
      </Grid>
    </section>
  </Section>

  <Section class="ds-home-meet">
    <Grid cols={2} class="ds-grid-861 ds-meet-grid">
      <div class="ds-meet-media">
        <Picture src={kavitaPhoto} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 540px" alt="Kavita Batchu, BHMS" loading="lazy" decoding="async" />
      </div>
      <div class="ds-meet-copy">
        <SectionHeader align="left" eyebrow="Meet Kavita" title={`Meet ${clinic.practitioner}`} />
        <p>{clinic.practitioner} holds a five-year BHMS degree and has over {clinic.years} years’ experience as a homeopath.</p>
        <p>Consultations are one-to-one, in person in Newport or by video from anywhere in the UK.</p>
        <ul class="ds-fact-list">
          <li>BHMS five-year degree</li>
          <li>{clinic.years}+ years’ experience</li>
          <li>One-to-one consultations</li>
        </ul>
        <a href="/about-kavita-batchu/" class="link-arrow">About Kavita</a>
      </div>
    </Grid>
  </Section>

  <Section tone="soft">
    <SectionHeader eyebrow="Ways to meet" title="Consultation options" />
    <Grid cols={4} class="ds-service-grid">
      {services.map((service) => {
        const isWhatsApp = service.href === clinic.whatsapp;
        const isFree = service.price === 'Free';
        return (
          <Card title={service.title} class={`ds-service-card${isFree ? ' ds-service-card-free' : ''}`}>
            <span class="ds-price-pill">{service.price}</span>
            <p class="ds-service-duration">{service.meta}</p>
            <a
              slot="link"
              href={service.href}
              class="ds-card-link ds-service-link"
              data-astro-prefetch={isWhatsApp ? undefined : ''}
              data-track={isWhatsApp ? 'click_whatsapp' : undefined}
              data-loc={isWhatsApp ? 'service_card' : undefined}
            >
              {isWhatsApp ? 'Message on WhatsApp' : <>Find out more<span class="visually-hidden"> about {service.title.toLowerCase()}</span></>}
            </a>
          </Card>
        );
      })}
    </Grid>
    <p class="ds-section-action"><a href="/consultation-fees/" class="link-arrow">See full fees</a></p>
  </Section>

  <Section>
    <SectionHeader eyebrow="Your consultation" title="What to expect" />
    <Grid cols={3} as="ol" class="ds-steps">
      <Card as="li" title="Get in touch">
        <p>Book online, call or send a WhatsApp message to get in touch.</p>
      </Card>
      <Card as="li" title="First consultation">
        <p>A private, one-to-one conversation about your health history, lifestyle and wellbeing.</p>
      </Card>
      <Card as="li" title="Follow-ups">
        <p>Usually {fees.followUp.interval}, in person or online.</p>
      </Card>
    </Grid>
    <p class="ds-section-action"><a href="/what-to-expect/" class="link-arrow">What to expect</a></p>
  </Section>

  {reviews.length > 0 && <div class="ds-home-reviews"><Reviews /></div>}

  <Section tone="soft" class="ds-home-faq">
    <SectionHeader eyebrow="Helpful answers" title="Common questions" />
    <FaqList items={homeFaqs} />
    <p class="ds-section-action"><a href="/frequently-asked-questions/" class="link-arrow">More questions</a></p>
  </Section>

  <Section class="ds-home-location">
    <SectionHeader eyebrow="Find us in Newport" title="Location, hours and areas" />
    <Grid cols={2} class="ds-grid-861 ds-location-grid">
      <Card title="Visit the clinic" icon="pin" class="ds-location-card">
        <p class="ds-contact-line"><Icon name="pin" /><span>{addressLine}</span></p>
        <p class="ds-contact-line"><Icon name="clock" /><span>{clinic.hoursText}</span></p>
        <p class="ds-contact-line"><a href={`tel:${clinic.phoneTel}`} data-track="click_call" data-loc="location"><Icon name="phone" /> Call {clinic.phoneDisplay}</a></p>
        <a class="btn btn-primary ds-directions-link" href={clinic.mapsUrl} target="_blank" rel="noopener noreferrer">Get directions</a>
      </Card>
      <div class="ds-location-map"><MapFacade /></div>
    </Grid>
    <div class="ds-location-areas">
      <ul class="ds-town-list">
        {featuredAreas.map((area) => <li class="ds-town-chip">{area}</li>)}
      </ul>
      <p class="ds-section-action"><a href="/areas-we-serve/" class="link-arrow">See all areas we serve</a></p>
    </div>
  </Section>

  <div class="ds-home-final-cta">
    <CtaBlock heading="Book a consultation" text="Book online or contact the clinic by phone or WhatsApp." />
  </div>
  <div class="ds-home-gp">
    <Container>
    <GpStatement />
    </Container>
  </div>
</Base>
