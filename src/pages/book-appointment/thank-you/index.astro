---
import Base from '../../../layouts/Base.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import { clinic } from '../../../data/site';
---
<Base
  title="Thank You | Newport Homeopathy Clinic"
  description="We received your enquiry and will reply within one working day. Contact the clinic if urgent."
  noindex
  breadcrumbs={[{ name: 'Book a consultation', href: '/book-appointment/' }, { name: 'Thank you', href: '/book-appointment/thank-you/' }]}
>
  <section data-lead-event>
    <div class="container text-col">
      <h1>Thank You for Your Enquiry</h1>
      <p class="lead">We've received your enquiry and will reply within one working day. If it's urgent, call {clinic.phoneDisplay}.</p>
      <p>You'll also get a confirmation email. If you don't see it, please check your spam folder.</p>
      <p><a href="/what-to-expect/">What to expect at your consultation</a></p>
    </div>
  </section>
  <CtaBlock text="" />
</Base>
