---
// Service cards list what the clinic offers, never conditions or outcomes.
import { services } from '../data/site';
---
<div class="service-grid">
  {services.map((s) => (
    <article class="card service-card">
      <h3>{s.title}</h3>
      <p class="price">{s.price} <span>{s.meta}</span></p>
      <a href={s.href} class="link-arrow">
        {s.title === 'Free discovery chat' ? 'Request a chat' : <>Find out more<span class="visually-hidden"> about {s.title.toLowerCase()}</span></>}
      </a>
    </article>
  ))}
</div>
