---
// Patient feedback (spec Part 5 §7). Renders nothing until approved, experience-only reviews exist in site.ts.
import { reviews, googleReviewUrl } from '../data/site';
import Section from './ds/Section.astro';
import SectionHeader from './ds/SectionHeader.astro';
import Grid from './ds/Grid.astro';
import Card from './ds/Card.astro';
---
{reviews.length > 0 && (
  <Section>
    <SectionHeader title="What clients say about their visit" />
      <Grid cols={3}>
        {reviews.map((r) => (
          <Card as="figure" class="review">
            <blockquote><p>“{r.quote}”</p></blockquote>
            <figcaption>— {r.name}{r.source && <span>, {r.source}</span>}</figcaption>
          </Card>
        ))}
      </Grid>
      {googleReviewUrl && <p class="ds-section-action"><a href={googleReviewUrl} rel="noopener noreferrer" class="link-arrow">Read more reviews on Google</a></p>}
  </Section>
)}
