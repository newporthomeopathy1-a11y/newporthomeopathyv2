---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { areas } from '../data/site';
---
<Base
  title="Homeopath near Telford & Shropshire | Newport Homeopathy"
  description="Our Newport clinic is easy to reach from Telford, Edgmond, Gnosall, Market Drayton, Stafford and Shrewsbury. Online across the UK."
  breadcrumbs={[{ name: 'Areas we serve', href: '/areas-we-serve/' }]}
>
  <PageIntro
    h1="Areas We Serve"
    lead="The Newport clinic serves nearby areas across east Shropshire and west Staffordshire. Online consultations are available anywhere in the UK."
  />
  <section class="section-top-none">
    <div class="container prose">
      <h2>Nearby areas</h2>
      <p>{areas.join(', ')}.</p>
      <p><a href="/online-homeopathy-consultation/">Online consultations</a> · <a href="/contact/">Directions</a> · <a href="/consultation-fees/">Fees</a></p>
    </div>
  </section>
  <CtaBlock text="" />
</Base>
