---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import GpStatement from '../components/GpStatement.astro';
import MapFacade from '../components/MapFacade.astro';
import Section from '../components/ds/Section.astro';
import Grid from '../components/ds/Grid.astro';
import Card from '../components/ds/Card.astro';
import Prose from '../components/ds/Prose.astro';
import { clinic, fees, addressLine } from '../data/site';
import { serviceSchema } from '../data/schema';
const initialDurationShort = fees.initial.duration.replace(/ minutes?$/, ' min');
---
<Base
  title={`In-Person Homeopathy Consultations | ${clinic.locality} ${clinic.postcode}`}
  description={`See ${clinic.practitioner}, ${clinic.qualification}, face to face at ${clinic.street}, ${clinic.locality}, ${clinic.region}. First consultation ${initialDurationShort}, £${fees.initial.price}; follow-ups £${fees.followUp.price}. ${clinic.hoursShort}.`}
  breadcrumbs={[{ name: 'In-person consultations', href: '/homeopathy-consultations/' }]}
  schema={[serviceSchema('in-person')]}
>
  <PageIntro
    h1={`In-Person Homeopathy Consultations at ${clinic.street}, ${clinic.locality}`}
    lead={`One-to-one homeopathy consultations with ${clinic.practitioner}, ${clinic.qualification}, at ${addressLine}. The initial consultation costs £${fees.initial.price} and lasts ${fees.initial.duration}; follow-ups cost £${fees.followUp.price}.`}
  >
    <p><a href="/areas-we-serve/">Areas we serve</a></p>
  </PageIntro>
  <Section>
    <Grid cols={2} class="ds-grid-861">
      <Prose>
        <h2>First consultation</h2>
        <p>A private conversation about your health history, lifestyle and wellbeing. <a href="/what-to-expect/">What to expect</a></p>
        <h2>Follow-ups</h2>
        <p>Usually {fees.followUp.interval}, in person or <a href="/online-homeopathy-consultation/">online</a>.</p>
        <h2>Hours</h2>
        <p>{clinic.hoursText}. <a href="/consultation-fees/">Fees</a></p>
        <GpStatement />
      </Prose>
      <Card title="Finding the clinic" titleAs="h2">
        <p>Parking and step-free access are available at the clinic.</p>
        <MapFacade />
        <p class="map-note"><a href="/areas-we-serve/">Areas we serve</a></p>
      </Card>
    </Grid>
  </Section>
  <CtaBlock text="" />
</Base>
